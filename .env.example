# .env.example
# Copy to .env and fill in real values. Never commit .env.

# --- Service ---
APP_ENV=development
HOST=0.0.0.0
PORT=8080

# --- Upstream LLM ---
# LLM_PROVIDER=mock    -> canned responses, no network call, no key needed
# LLM_PROVIDER=ollama  -> local Ollama via its OpenAI-compatible endpoint, no key needed
# LLM_PROVIDER=<anything else> -> generic OpenAI-compatible endpoint, LLM_API_KEY required
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1
LLM_TIMEOUT_S=30

# --- Auth / RBAC: {api_key: role}, role in {admin,user,readonly} ---
# If unset, demo keys are used (see app/config.py) — fine for local dev only.
API_KEYS_JSON={"demo-admin-key": "admin", "demo-user-key": "user"}

# --- Rate limiting (token bucket, per principal) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# --- Anomaly / extraction-signal detection ---
ANOMALY_WINDOW_S=60
ANOMALY_BURST_THRESHOLD=30
ANOMALY_DIVERSITY_MIN_REQUESTS=15
ANOMALY_DIVERSITY_THRESHOLD=0.85

# --- Jailbreak detection ---
JAILBREAK_THRESHOLD=0.5
# Directory produced by `python -m app.jailbreak.train` (DistilBERT fine-tune).
# If it doesn't exist, the gateway degrades to the keyword heuristic only.
JAILBREAK_MODEL_PATH=models/jailbreak_classifier

# --- PII scrubbing ---
PII_REDACT_IN_LOGS=true
PII_BLOCK_ON_DETECT=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/gateway.jsonl
